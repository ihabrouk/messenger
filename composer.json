{
  "name": "ihabrouk/messenger",
  "description": "A Laravel package for multi-provider messaging (SMS, WhatsApp, Email) with consent management and analytics",
  "type": "library",
  "keywords": [
    "laravel",
    "sms",
    "whatsapp",
    "email",
    "messaging",
    "twilio",
    "consent",
    "gdpr"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Ismail El Habrouk",
      "email": "ihabrouk@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "laravel/framework": "^11.0|^12.0|^13.0|^14.0",
    "filament/filament": "^4.0|^5.0",
    "guzzlehttp/guzzle": "^7.0",
    "twilio/sdk": "^7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0",
    "orchestra/testbench": "^10",
    "laravel/pint": "^1"
  },
  "autoload": {
    "psr-4": {
      "Ihabrouk\\Messenger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ihabrouk\\Messenger\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.0.3-dev"
    },
    "laravel": {
      "providers": [
        "Ihabrouk\\Messenger\\Providers\\MessengerServiceProvider"
      ],
      "aliases": {
        "Messenger": "Ihabrouk\\Messenger\\Facades\\Messenger"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
